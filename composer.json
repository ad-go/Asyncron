{
    "name": "ad-go/asyncron",
    "description": "CodeIgniter 4 library: multi-master file/DB/session replication (Cluster, AdGo\\Cluster\\) plus its Dashboard/Profile/Settings/Users admin UI (AdGo\\Cluster\\UI\\) - composer require this onto a framework+shield+settings+tasks+queue skeleton, see README for the exact install order.",
    "license": "MIT",
    "type": "library",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/queue": "^1.0",
        "codeigniter4/settings": "^2.4",
        "codeigniter4/shield": "^1.4",
        "codeigniter4/tasks": "^1.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "AdGo\\Cluster\\": "src/",
            "AdGo\\Cluster\\UI\\": "src/UI/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**",
            "src/UI/Templates/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "post-install-cmd": [
            "@php spark app:install"
        ],
        "post-update-cmd": [
            "@php spark app:install"
        ]
    }
}
