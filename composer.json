{
    "name": "ad-go/asyncron",
    "description": "Self-contained CodeIgniter 4 app: multi-master file/DB/session replication (Cluster) plus its Dashboard/Profile/Settings/Users admin UI, ready to install with a single composer command - no plugin, no dev-stability packages.",
    "license": "MIT",
    "type": "project",
    "require": {
        "php": "^8.2",
        "codeigniter4/framework": "^4.7",
        "codeigniter4/queue": "^1.0",
        "codeigniter4/settings": "^2.4",
        "codeigniter4/shield": "^1.4",
        "codeigniter4/tasks": "^1.0",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "fakerphp/faker": "^1.9",
        "mikey179/vfsstream": "^1.6",
        "phpunit/phpunit": "^10.5.16"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Config\\": "app/Config/",
            "AdGo\\Cluster\\": "src/"
        },
        "exclude-from-classmap": [
            "**/Database/Migrations/**"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Support\\": "tests/_support"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "post-create-project-cmd": [
            "@php spark app:install"
        ]
    }
}
